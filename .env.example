# 灵山胜境 AI 数字人环境配置示例
# 复制为 .env 后填写真实 Key。不要提交 .env。

# 核心文本/多模态大模型，默认推荐 DashScope Qwen3-VL。
SCENIC_LLM_ENABLED=true
SCENIC_LLM_PROVIDER=dashscope
SCENIC_LLM_MODEL=qwen3-vl-plus
SCENIC_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=
SCENIC_LLM_TEMPERATURE=0.35
SCENIC_LLM_MAX_TOKENS=700
SCENIC_LLM_TIMEOUT=5
SCENIC_LLM_RETRIES=2

# 弱网/答辩现场可临时改为 true，仅使用本地知识和规则兜底。
SCENIC_CHAT_FAST_MODE=false
SCENIC_KNOWLEDGE_ANSWER_THRESHOLD=0.68

# 图片识别讲解使用独立视觉模型配置。未设置 SCENIC_VISION_API_KEY 时会复用 DASHSCOPE_API_KEY。
SCENIC_VISION_PROVIDER=dashscope
SCENIC_VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
SCENIC_VISION_MODEL=qwen3-vl-flash
SCENIC_VISION_TIMEOUT=60
SCENIC_VISION_MAX_TOKENS=420
# SCENIC_VISION_API_KEY=sk-your-vision-api-key

# 管理端令牌。生产或正式演示请改成强随机字符串。
SCENIC_ADMIN_TOKEN=

# 浏览器跨域来源白名单。
SCENIC_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8000

# LiveTalking 实时数字人服务。默认使用相邻目录 ../portable_livetalking 中训练好的 test1。
VITE_LIVETALKING_ENABLED=true
VITE_LIVETALKING_BASE=http://127.0.0.1:8010
VITE_LIVETALKING_DIR=D:\download\portable_livetalking.zip\景区数字人\portable_livetalking
VITE_LIVETALKING_AVATAR=test1
VITE_LIVETALKING_TTS_MODE=edgetts
VITE_LIVETALKING_VOICE=zh-CN-YunyangNeural
# 若 LiveTalking 以 cosyvoice/gpt-sovits 启动，可启用下面的参考音频配置。
VITE_LIVETALKING_REF_AUDIO=data/ref_audio/test1.wav
VITE_LIVETALKING_REF_TEXT=阿弥陀佛，施主您好。欢迎来到灵山胜景。请随我漫步胜景，静听这千年的钟声，享受美景吧！

# 行为样本导入体积控制。
SCENIC_BEHAVIOR_STORE_RAW_JSON=false
SCENIC_BEHAVIOR_CONTENT_MAX_CHARS=360

# 豆包/火山引擎语音合成，可选。未配置时前端回退浏览器语音。
DOUBAO_TTS_ENABLED=true
DOUBAO_TTS_APP_ID=
DOUBAO_TTS_ACCESS_TOKEN=
DOUBAO_TTS_CLUSTER=volcano_tts
DOUBAO_TTS_VOICE_TYPE=BV700_streaming
DOUBAO_TTS_TIMEOUT=8

# 本地 ASR 示例，可选。
# SCENIC_ASR_ENABLED=true
# SCENIC_ASR_PROVIDER=local_whisper
# SCENIC_ASR_COMMAND=whisper {audio} --language zh --task transcribe --output_format txt --output_dir {output}
# SCENIC_ASR_TIMEOUT=45

# 云端 ASR 示例，可选。
# SCENIC_ASR_ENABLED=true
# SCENIC_ASR_PROVIDER=cloud
# SCENIC_ASR_ENDPOINT=https://your-asr-service/transcribe
# SCENIC_ASR_API_KEY=

# DeepSeek 文字模型备用。图片讲解仍建议使用 DashScope Qwen3-VL。
# SCENIC_LLM_PROVIDER=deepseek
# SCENIC_LLM_MODEL=deepseek-chat
# SCENIC_LLM_BASE_URL=https://api.deepseek.com
# DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# 自部署或其他 OpenAI 兼容服务。
# SCENIC_LLM_PROVIDER=custom
# SCENIC_LLM_MODEL=your-model
# SCENIC_LLM_BASE_URL=http://your-host:port/v1
# SCENIC_LLM_API_KEY=your-api-key-if-needed
# SCENIC_VISION_PROVIDER=custom
# SCENIC_VISION_MODEL=your-vision-model
# SCENIC_VISION_BASE_URL=http://your-host:port/v1
# SCENIC_VISION_API_KEY=your-vision-api-key-if-needed

# 高德地图底图，可选。填写 Web JS API Key 后前端会启用真实底图。
# VITE_AMAP_KEY=your-amap-web-js-key
# VITE_AMAP_SECURITY_CODE=your-amap-security-code
