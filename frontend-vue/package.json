{
  "name": "scenic-guide-vue",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "patch:vite": "node scripts/patch-vue-plugin.mjs",
    "typecheck": "vue-tsc --noEmit",
    "clean": "powershell -ExecutionPolicy Bypass -File ../scripts/clean_workspace.ps1 -Dist",
    "dev": "npm run patch:vite && vite --configLoader native --host 127.0.0.1",
    "build": "npm run typecheck && npm run patch:vite && vite build --configLoader native",
    "preview": "vite preview --configLoader native --host 127.0.0.1",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "echarts": "^5.5.1",
    "lucide-vue-next": "^0.468.0",
    "pinia": "^3.0.4",
    "vite": "^6.0.7",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "lightningcss": "^1.32.0",
    "terser": "^5.48.0",
    "typescript": "^5.7.2",
    "vitest": "^4.1.9",
    "vue-tsc": "^2.2.0"
  }
}
